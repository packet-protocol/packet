{
  "name": "xpkt-mcp",
  "version": "0.1.4",
  "description": "MCP for Packet protocol",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "bin": {
    "packet-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "npm run clean && npm run typecheck && node esbuild.config.mjs && chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "start": "node ./dist/index.js",
    "clean": "rm -rf dist .types",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build",
    "pack:check": "npm pack --dry-run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/packet-protocol/packet.git"
  },
  "keywords": [
    "solana",
    "packet",
    "communication",
    "decentralized",
    "payment",
    "mcp"
  ],
  "author": "@packetchat",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@solana/web3.js": "^1.98.4",
    "dotenv": "^17.4.2",
    "tweetnacl": "^1.0.3",
    "xpkt-sdk": "^0.1.4",
    "zod": "^4.4.3",
    "@irys/upload": "^0.0.15",
    "@irys/upload-solana": "^0.1.8",
    "file-type": "^22.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
